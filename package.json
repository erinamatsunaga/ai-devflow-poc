{
  "name": "ai-devflow-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIによる開発自動化（開発→CI→PR→自動デプロイ）の検証用リポジトリ",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
